{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "noImplicitAny": true,
    "strictNullChecks": false
  },
  "include": [
    "worker.mjs",
    "authorization.mjs",
    "security-policy.mjs",
    "rate-limiter.mjs",
    "export-projection.mjs",
    "worker-configuration.d.ts",
    "protocol.d.ts"
  ]
}
