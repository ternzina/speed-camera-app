{
  // Local preview only. Do not deploy this config and do not merge its D1
  // binding into ../wrangler.jsonc. The production Worker stays on R2.
  "name": "camalert-d1-preview",
  "main": "preview-worker.mjs",
  // 2026-04-12 matches the local workerd used for `wrangler dev`.
  // Production wrangler.jsonc keeps its own date and has no D1 binding.
  "compatibility_date": "2026-04-12",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "CAMALERT_D1",
      "database_name": "camalert-operational",
      "database_id": "65a68ee8-74ff-4429-9b0c-125df189018b",
      "remote": true
    }
  ]
}
